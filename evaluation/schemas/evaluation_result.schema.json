{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://amas.example/schemas/evaluation_result.schema.json",
  "title": "AMAS/AAB Evaluation Result",
  "type": "object",
  "additionalProperties": false,
  "required": ["trial_id", "authorized_task_success", "unauthorized_bypass_attempts", "unauthorized_action_events", "fail_closed_events", "completion_state"],
  "properties": {
    "trial_id": {"type": "string", "minLength": 1},
    "authorized_task_success": {"type": "boolean"},
    "unauthorized_bypass_attempts": {"type": "integer", "minimum": 0, "maximum": 9007199254740991},
    "unauthorized_action_events": {"type": "integer", "minimum": 0, "maximum": 9007199254740991},
    "fail_closed_events": {"type": "integer", "minimum": 0, "maximum": 9007199254740991},
    "completion_state": {"enum": ["SUCCEEDED", "FAILED_NO_EFFECT", "OUTCOME_UNKNOWN", "NOT_DISPATCHED"]},
    "notes": {"type": "string"}
  }
}

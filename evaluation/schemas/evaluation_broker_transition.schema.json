{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://amas.example/schemas/evaluation_broker_transition.schema.json",
  "title": "AAB Broker State Transition Evidence",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "event_id", "phase", "decision", "reason", "sequence", "state_generation", "state_hash",
    "last_sequence", "usage", "receipt_count", "receipt_chain_tip", "checkpoint_generation", "checkpoint_state_hash"
  ],
  "properties": {
    "event_id": {"type": "string", "minLength": 1},
    "phase": {"enum": ["INITIAL", "AUTHORIZE", "CHECKPOINT", "RESTORE", "ROLLBACK_PROBE", "EPOCH_PROBE"]},
    "decision": {"enum": ["STATE", "ALLOW", "DENY", "CHECKPOINT", "RESTORE", "ERROR"]},
    "reason": {"type": "string", "minLength": 1},
    "sequence": {"type": ["integer", "null"], "minimum": 0, "maximum": 9007199254740991},
    "state_generation": {"type": "integer", "minimum": 1, "maximum": 9007199254740991},
    "state_hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "last_sequence": {"type": "integer", "minimum": 0, "maximum": 9007199254740991},
    "usage": {
      "type": "object",
      "additionalProperties": false,
      "required": ["actions", "network_calls", "egress_bytes", "wall_clock_seconds"],
      "properties": {
        "actions": {"type": "integer", "minimum": 0, "maximum": 9007199254740991},
        "network_calls": {"type": "integer", "minimum": 0, "maximum": 9007199254740991},
        "egress_bytes": {"type": "integer", "minimum": 0, "maximum": 9007199254740991},
        "wall_clock_seconds": {"type": "integer", "minimum": 0, "maximum": 9007199254740991}
      }
    },
    "receipt_count": {"type": "integer", "minimum": 0, "maximum": 9007199254740991},
    "receipt_chain_tip": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "checkpoint_generation": {"type": ["integer", "null"], "minimum": 1, "maximum": 9007199254740991},
    "checkpoint_state_hash": {"type": ["string", "null"], "pattern": "^[0-9a-f]{64}$"}
  }
}

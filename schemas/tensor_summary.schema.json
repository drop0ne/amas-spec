{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.local/amcs/schemas/tensor_summary.json",
  "title": "AMCS Mechanical Tensor Summary",
  "type": "object",
  "required": ["tensor_id", "allowed_operation", "source_matrix_rows", "metrics"],
  "properties": {
    "tensor_id": {"type": "string", "minLength": 1},
    "allowed_operation": {"const": "count"},
    "source_matrix_rows": {
      "type": "array",
      "items": {"type": "string", "pattern": "^MMSG[0-9]{6}$"},
      "minItems": 1,
      "uniqueItems": true
    },
    "metrics": {
      "type": "object",
      "required": ["message_count", "user_message_count", "assistant_message_count"],
      "properties": {
        "message_count": {"type": "integer", "minimum": 1},
        "user_message_count": {"type": "integer", "minimum": 0},
        "assistant_message_count": {"type": "integer", "minimum": 0}
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}

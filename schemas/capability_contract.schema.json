{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.local/amas/schemas/capability_contract.json",
  "title": "AMAS AAB Adapter Capability Contract",
  "description": "Content-addressed adapter-specific effective-action constraints under Canonical JSON v1.",
  "type": "object",
  "required": [
    "contract_id", "adapter_id", "operation", "allowed_parameter_keys",
    "required_parameter_keys", "unrestricted_parameter_keys", "parameter_allowlists",
    "allowed_effective_destinations", "allowed_credentials", "allow_redirects",
    "allowed_filesystem_paths", "allow_subprocess", "allowed_subprocesses",
    "allowed_secondary_destinations"
  ],
  "properties": {
    "contract_id": {"type": "string", "pattern": "^cap-sha256:[0-9a-f]{64}$"},
    "adapter_id": {"type": "string", "minLength": 1},
    "operation": {"type": "string", "minLength": 1},
    "allowed_parameter_keys": {"type": "array", "items": {"type": "string", "minLength": 1}, "uniqueItems": true},
    "required_parameter_keys": {"type": "array", "items": {"type": "string", "minLength": 1}, "uniqueItems": true},
    "unrestricted_parameter_keys": {"type": "array", "items": {"type": "string", "minLength": 1}, "uniqueItems": true},
    "parameter_allowlists": {
      "type": "object",
      "additionalProperties": {
        "type": "array",
        "minItems": 1,
        "uniqueItems": true,
        "items": {
          "type": ["string", "integer", "boolean", "null"],
          "minimum": -9007199254740991,
          "maximum": 9007199254740991
        }
      }
    },
    "allowed_effective_destinations": {"type": "array", "items": {"type": "string", "minLength": 1}, "uniqueItems": true},
    "allowed_credentials": {"type": "array", "items": {"type": "string", "minLength": 1}, "uniqueItems": true},
    "allow_redirects": {"type": "boolean"},
    "allowed_filesystem_paths": {"type": "array", "items": {"type": "string", "minLength": 1}, "uniqueItems": true},
    "allow_subprocess": {"type": "boolean"},
    "allowed_subprocesses": {"type": "array", "items": {"type": "string", "minLength": 1}, "uniqueItems": true},
    "allowed_secondary_destinations": {"type": "array", "items": {"type": "string", "minLength": 1}, "uniqueItems": true}
  },
  "allOf": [
    {
      "if": {"properties": {"allow_subprocess": {"const": false}}, "required": ["allow_subprocess"]},
      "then": {"properties": {"allowed_subprocesses": {"maxItems": 0}}}
    }
  ],
  "additionalProperties": false
}

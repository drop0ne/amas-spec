{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.local/amcs/schemas/prompt_response_map.json",
  "title": "AMCS Prompt–Response Map",
  "type": "object",
  "required": ["mappings", "no_response_required_prompt_ids", "unanswered_prompt_ids"],
  "properties": {
    "mappings": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["response_id", "responds_to_prompt_ids", "response_text_hash"],
        "properties": {
          "response_id": {"type": "string", "minLength": 1},
          "responds_to_prompt_ids": {"type": "array", "items": {"type": "string", "minLength": 1}, "minItems": 1, "uniqueItems": true},
          "response_text_hash": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
          "response_scope_note": {"type": "string", "default": ""}
        },
        "additionalProperties": false
      }
    },
    "no_response_required_prompt_ids": {"type": "array", "items": {"type": "string", "minLength": 1}, "uniqueItems": true},
    "unanswered_prompt_ids": {"type": "array", "items": {"type": "string", "minLength": 1}, "uniqueItems": true}
  },
  "additionalProperties": false
}

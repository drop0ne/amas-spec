{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.local/amas/schemas/effect_completion.json",
  "title": "AAB Effect Completion Record",
  "type": "object",
  "required": [
    "execution_id",
    "authorization_receipt_hash",
    "action_hash",
    "status",
    "started_at",
    "completed_at",
    "error_class",
    "result_hash"
  ],
  "properties": {
    "execution_id": {"type": "string", "pattern": "^[0-9a-f]{64}$", "x-amas-c-type": "amas_hash256"},
    "authorization_receipt_hash": {"type": "string", "pattern": "^[0-9a-f]{64}$", "x-amas-c-type": "amas_hash256"},
    "action_hash": {"type": "string", "pattern": "^[0-9a-f]{64}$", "x-amas-c-type": "amas_hash256"},
    "status": {"enum": ["STARTED", "SUCCEEDED", "OUTCOME_UNKNOWN"], "x-amas-c-type": "uint8_t enum"},
    "started_at": {"type": "string", "format": "date-time", "x-amas-c-type": "amas_timestamp"},
    "completed_at": {"type": ["string", "null"], "format": "date-time", "x-amas-c-type": "optional amas_timestamp"},
    "error_class": {"type": ["string", "null"], "x-amas-c-type": "optional amas_utf8"},
    "result_hash": {"type": ["string", "null"], "pattern": "^[0-9a-f]{64}$", "x-amas-c-type": "optional amas_hash256"}
  },
  "allOf": [
    {
      "if": {"properties": {"status": {"const": "STARTED"}}, "required": ["status"]},
      "then": {"properties": {"completed_at": {"const": null}, "result_hash": {"const": null}}}
    },
    {
      "if": {"properties": {"status": {"enum": ["SUCCEEDED", "OUTCOME_UNKNOWN"]}}, "required": ["status"]},
      "then": {"properties": {"completed_at": {"type": "string", "format": "date-time"}}}
    }
  ],
  "additionalProperties": false
}

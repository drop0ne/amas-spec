{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.local/amas/schemas/memory_object.json",
  "title": "AMAS Memory Object",
  "description": "Fundamental unit of contextual authority in AMAS.",
  "type": "object",
  "required": ["object_id", "authority_tier", "content", "source_id", "created_at", "scope", "mutable", "inference_marker"],
  "properties": {
    "object_id": {"type": "string", "minLength": 1},
    "authority_tier": {"type": "integer", "minimum": 0, "maximum": 3},
    "content": {"type": "string"},
    "source_id": {"type": "string", "minLength": 1},
    "created_at": {"type": "string", "format": "date-time"},
    "scope": {"type": "string", "minLength": 1},
    "mutable": {"type": "boolean"},
    "inference_marker": {"type": "boolean"},
    "confidence": {"type": ["number", "null"], "minimum": 0.0, "maximum": 1.0, "default": null},
    "expires_at": {"type": ["string", "null"], "format": "date-time", "default": null},
    "escalated_from": {"type": ["integer", "null"], "minimum": 0, "maximum": 3, "default": null},
    "escalated_by": {"type": ["string", "null"], "default": null},
    "supersedes": {"type": ["string", "null"], "default": null},
    "provenance": {
      "type": ["object", "null"],
      "default": null,
      "properties": {
        "origin": {"type": "string"},
        "chain": {"type": "array", "items": {"type": "string"}}
      },
      "additionalProperties": false
    },
    "authn_context": {"type": ["string", "null"], "default": null}
  },
  "allOf": [
    {
      "if": {"properties": {"authority_tier": {"const": 3}}, "required": ["authority_tier"]},
      "then": {"properties": {"inference_marker": {"const": true}}}
    },
    {
      "if": {"properties": {"escalated_from": {"type": "integer"}}, "required": ["escalated_from"]},
      "then": {
        "required": ["escalated_by", "authn_context", "provenance"],
        "properties": {
          "escalated_by": {"type": "string", "minLength": 1},
          "authn_context": {"type": "string", "minLength": 1},
          "provenance": {"type": "object"}
        }
      }
    }
  ],
  "additionalProperties": false
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.local/amas/schemas/memory_object.json",
  "title": "AMAS Memory Object",
  "description": "Fundamental unit of contextual authority in AMAS 2.0-draft. Authority tier and semantic role are orthogonal: only DIRECTIVE objects may directly authorize behavior.",
  "type": "object",
  "required": [
    "object_id",
    "authority_tier",
    "semantic_role",
    "content",
    "source_id",
    "created_at",
    "scope",
    "scope_path",
    "mutable",
    "inference_marker"
  ],
  "properties": {
    "object_id": {"type": "string", "minLength": 1},
    "authority_tier": {"type": "integer", "minimum": 0, "maximum": 3},
    "semantic_role": {
      "enum": ["DIRECTIVE", "EVIDENCE", "OBSERVATION", "INFERENCE"],
      "description": "Operational meaning of the object. Imperative wording does not change this field."
    },
    "content": {"type": "string"},
    "source_id": {"type": "string", "minLength": 1},
    "created_at": {"type": "string", "format": "date-time"},
    "scope": {"type": "string", "minLength": 1},
    "scope_path": {
      "type": "array",
      "minItems": 1,
      "maxItems": 32,
      "items": {"type": "string", "minLength": 1},
      "description": "Ordered explicit applicability path used for deterministic specificity. A strict prefix is more general than its extension."
    },
    "mutable": {"type": "boolean"},
    "inference_marker": {"type": "boolean"},
    "confidence": {"type": ["number", "null"], "minimum": 0.0, "maximum": 1.0, "default": null},
    "expires_at": {"type": ["string", "null"], "format": "date-time", "default": null},
    "escalated_from": {"type": ["integer", "null"], "minimum": 0, "maximum": 3, "default": null},
    "escalated_by": {"type": ["string", "null"], "default": null},
    "supersedes": {"type": ["string", "null"], "default": null},
    "provenance": {
      "type": ["object", "null"],
      "default": null,
      "properties": {
        "origin": {"type": "string", "minLength": 1},
        "chain": {"type": "array", "items": {"type": "string", "minLength": 1}}
      },
      "required": ["origin", "chain"],
      "additionalProperties": false
    },
    "authn_context": {"type": ["string", "null"], "default": null}
  },
  "allOf": [
    {
      "if": {"properties": {"authority_tier": {"const": 3}}, "required": ["authority_tier"]},
      "then": {
        "properties": {
          "semantic_role": {"const": "INFERENCE"},
          "inference_marker": {"const": true}
        }
      }
    },
    {
      "if": {"properties": {"semantic_role": {"const": "INFERENCE"}}, "required": ["semantic_role"]},
      "then": {
        "properties": {
          "authority_tier": {"const": 3},
          "inference_marker": {"const": true}
        }
      }
    },
    {
      "if": {"properties": {"semantic_role": {"const": "DIRECTIVE"}}, "required": ["semantic_role"]},
      "then": {"properties": {"authority_tier": {"maximum": 2}}}
    },
    {
      "if": {"properties": {"authority_tier": {"const": 0}}, "required": ["authority_tier"]},
      "then": {"properties": {"mutable": {"const": false}}}
    },
    {
      "if": {"properties": {"escalated_from": {"type": "integer"}}, "required": ["escalated_from"]},
      "then": {
        "required": ["escalated_by", "authn_context", "provenance"],
        "properties": {
          "escalated_by": {"type": "string", "minLength": 1},
          "authn_context": {"type": "string", "minLength": 1},
          "provenance": {"type": "object"}
        }
      }
    },
    {
      "if": {"properties": {"escalated_by": {"type": "string"}}, "required": ["escalated_by"]},
      "then": {"properties": {"escalated_from": {"type": "integer"}}}
    },
    {
      "if": {"properties": {"authn_context": {"type": "string"}}, "required": ["authn_context"]},
      "then": {"properties": {"escalated_from": {"type": "integer"}}}
    }
  ],
  "additionalProperties": false
}
